# Server host and port
HOST=127.0.0.1
PORT=8000
# JSON list of accepted bearer keys; empty disables authentication.
SEARCH_EMBEDDING_API_KEYS=[]

# Model configuration
MODEL_ID=google/embeddinggemma-2
MODEL_REVISION=914f7f89142e33e77833254d9c9b90c3cef7303b
DEVICE=auto
TORCH_DTYPE=float32
USE_FAKE_ADAPTER=false

# Concurrency and queue limits
MAX_CONCURRENCY=1
MAX_QUEUE_SIZE=10

# Request limits
MAX_BATCH_SIZE=32
MAX_UPLOAD_BYTES=52428800
MAX_EMBEDDING_REQUEST_BYTES=104857600
URL_DOWNLOAD_MAX_BYTES=52428800
URL_DOWNLOAD_TIMEOUT_SECONDS=20
# Empty allows public HTTPS hosts; set exact hostnames to restrict downloads.
URL_ALLOWED_HOSTS=[]
UPLOAD_TTL_SECONDS=300
UPLOAD_DIR=/tmp/multimodal_embedding_api/uploads

# Media limits
MAX_IMAGE_PIXELS=16777216
MAX_AUDIO_DURATION_SECONDS=30.0
MAX_VIDEO_DURATION_SECONDS=60.0

# Sampling parameters
VIDEO_FPS=1
MAX_VIDEO_FRAMES=32
VISION_MAX_SOFT_TOKENS=280

MAX_CONTEXT_TOKENS=8192
VIDEO_MAX_SOFT_TOKENS=140
